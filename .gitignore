# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Confidential client proposals — repo is public, keep pricing/strategy out of git
docs/Proposta-*.pdf
docs/proposta-*.html
# ...and the README that documents them: it carries as faixas de preço and the
# cost-anchor formula, which is exactly the material that must stay out of git.
docs/README.md

# Visual brainstorming companion (local, ephemeral)
.superpowers/
